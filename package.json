{
  "name": "newnonmun_react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node -e \"const fs=require('fs');fs.copyFileSync('serve.json','dist/serve.json');fs.copyFileSync('_worker.js','dist/_worker.js');\"",
    "preview": "vite preview",
    "worker:copy": "node -e \"const fs=require('fs');fs.copyFileSync('_worker.js','dist/_worker.js');console.log('_worker.js copied to dist/')\"",
    "pages:dev": "npm run worker:copy && npx wrangler pages dev dist --port 8788 --ip 0.0.0.0 --ai AI",
    "deploy": "npx wrangler pages deploy dist --project-name newnonmun-front --branch develop",
    "lint": "eslint src",
    "generate-api": "orval"
  },
  "dependencies": {
    "@tanstack/query-sync-storage-persister": "^5.100.10",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-query-persist-client": "^5.100.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20.19.39",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "orval": "^7.13.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.4.1"
  }
}
